# --- Chatbot core ---
# Required for live general answers (Groq).
GROQ_API_KEY=your_groq_api_key_here
# LLM model (preserved from the existing project).
LLM_MODEL=openai/gpt-oss-120b
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Enquiry notification email (Brevo) ---
BREVO_API_KEY=
ENQUIRY_EMAIL_TO=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Website Enquiry Bot

# --- RAG / retrieval (all optional; sensible defaults provided) ---
# Sentence-transformers embedding model. Must match the one used to build
# data/embeddings.pkl.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Lightweight English CrossEncoder reranker.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Project-relative path of the retrieval index.
RAG_INDEX_PATH=data/embeddings.pkl
# Candidate chunks retrieved before reranking.
RAG_INITIAL_TOP_K=10
# Final chunks sent to the LLM after reranking.
RAG_FINAL_TOP_K=5
# Maximum context characters sent to the LLM.
RAG_MAX_CONTEXT_CHARS=6000

# --- Conversation History Context ---
# Number of past messages sent to LLM for conversational context (e.g. 6 = last 3 user + 3 assistant turns)
CHAT_HISTORY_CONTEXT_MESSAGES=6
# Maximum messages preserved in-memory per session
MAX_SESSION_HISTORY_MESSAGES=20

